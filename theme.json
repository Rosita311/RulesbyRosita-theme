{
  "version": 3,
  "settings": {
    "appearanceTools": true, 
    "layout": {
      "contentSize": "52.5rem",
      "wideSize": "75rem"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "text", "name": "Text", "color": "#192324" },
        { "slug": "primary", "name": "Primary", "color": "#d7233e" },
        { "slug": "accent", "name": "Accent", "color": "#f8c9d7" },
        { "slug": "accent-2", "name": "Accent 2", "color": "#ebebeb" },
        { "slug": "footer", "name": "Footer", "color": "#cbeef3" },
        { "slug": "contrast", "name": "Contrast", "color": "#49b3c1" },
        { "slug": "background", "name": "Background", "color": "#f8f4f5" },
        { "slug": "placeholder", "name": "Placeholder", "color": "#6e6e6e" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Nunito\", sans-serif",
          "slug": "body",
          "name": "Body"
        },
        {
          "fontFamily": "\"Zilla Slab\", serif",
          "slug": "heading",
          "name": "Heading"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "normal", "size": "1rem", "name": "Normal" },
        { "slug": "large", "size": "1.5rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "name": "Extra Large" }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        {
          "slug": "xs",
          "name": "Extra Small",
          "size": "0.5rem"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "1rem"
        },
        {
          "slug": "md",
          "name": "Medium",
          "size": "2rem"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "4rem"
        },
        {
          "slug": "xl",
          "name": "Extra Large",
          "size": "6rem"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "aspectRatio": true,
      "minHeight": true
    },
    "position": {
      "sticky": true
    },
    "lightbox": {
      "enabled": true
    },
    "custom": {
      "border-radius": {
        "small": "0.25rem",
        "medium": "0.5rem",
        "large": "1rem"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--normal)",
      "lineHeight": "1.5"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--md)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "lineHeight": "1.3"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },

      "button": {
        "border": {
          "radius": "var(--wp--custom--border-radius--medium)"
        }
      }
    }
  }
}
